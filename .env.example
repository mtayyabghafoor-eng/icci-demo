# Copy this file to .env.local and fill in the values.
# .env.local is never committed and must never be shared or pasted into chat.
#
# Where to find the values: Supabase dashboard > your icci-dev project >
# Project Settings > API Keys (and Data API for the URL).

# Which environment this is. The seed and reset scripts refuse to run
# unless this says "development".
ICCI_ENVIRONMENT=development

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable" key (starts with sb_publishable_). Safe for the browser:
# it only grants what the row-level security rules allow.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret" key (starts with sb_secret_). Bypasses all security rules.
# Used only by the seed script and tests on this PC. Never in the website.
SUPABASE_SECRET_KEY=

# Password for the fictional test admin accounts. Filled in automatically
# by: npm run setup:test-password
TEST_USER_PASSWORD=

# --- Email reminders (slice P2.9) -------------------------------------------
# The daily reminder timer's key. Filled in automatically by:
#   npm run setup:reminder-key
# When the site is online, the same value goes into Vercel as CRON_SECRET.
CRON_SECRET=

# The email service (Resend). Leave empty until the account exists: the
# reminders are then only recorded, never sent. On the development
# database nothing is ever sent to the test accounts, whatever is set here.
RESEND_API_KEY=
# Who the emails come from, e.g. ICCI Dashboard <onboarding@resend.dev>
REMINDER_FROM=
# Where "Send a test email" goes: the project-only mailbox.
REMINDER_TEST_TO=
# The site's address, for the link in the email, e.g. https://example.vercel.app
SITE_URL=
